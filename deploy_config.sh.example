#!/bin/bash

# 🔐 Deployment Configuration
# Copy this file to deploy_config.sh and fill in your credentials
# deploy_config.sh is gitignored for security

# Server Configuration
export SERVER_IP="your_server_ip"
export SERVER_USER="your_username"
export SERVER_PASSWORD="your_password"
export APP_PATH="~/erpmax_web"
export BACKUP_PATH="~/backups/erpmax_web"

# Optional: Backend API Configuration
export BACKEND_PORT="8080"
